# GuardianTwin Backend — Environment Variables
# Copy to backend/.env and fill in your values

# Fireworks AI (required — same key used by main.py)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/minimax-m2p1

# MQTT broker (Docker default)
MQTT_BROKER=localhost
MQTT_PORT=1883

# InfluxDB (Docker default)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=guardiantwin-token
INFLUXDB_ORG=guardiantwin
INFLUXDB_BUCKET=sensors

# MongoDB Atlas (optional — from existing .env)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=building_analysis
